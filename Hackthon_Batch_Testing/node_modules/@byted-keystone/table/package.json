{
  "name": "@byted-keystone/table",
  "version": "0.0.1",
  "description": "Headless UI for building powerful tables & datagrids for TS/JS.",
  "keywords": [
    "react",
    "vue",
    "solid",
    "table",
    "table-core",
    "datagrid"
  ],
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=12"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@rslib/core": "0.16.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "build": "rslib build",
    "dev": "rslib build --watch"
  }
}