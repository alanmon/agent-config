{
  "name": "@byted-keystone/core",
  "description": "An out-of-the-box design system for beautifully crafted web components.",
  "version": "1.1.68",
  "license": "MIT",
  "bugs": "https://code.byted.org/ad/byted-web-components/issues",
  "repository": {
    "type": "git",
    "url": "https://code.byted.org/ad/byted-web-components.git",
    "directory": "packages/ui-next/core"
  },
  "keywords": [
    "Keystone",
    "Web Components",
    "Design System"
  ],
  "sideEffects": [
    "./dist/components/index.js",
    "./dist/bundle.cjs.js",
    "./dist/index.css"
  ],
  "main": "dist/bundle.cjs.js",
  "module": "dist/components/index.js",
  "types": "dist/components/index.d.ts",
  "style": "dist/keystone/keystone.css",
  "unpkg": "latest",
  "unpkgFiles": [
    "dist/keystone"
  ],
  "files": [
    "dist/",
    "loader/",
    "LICENSE",
    "readme.md",
    "postinstall.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/components/index.js",
      "require": "./dist/bundle.cjs.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./dist/components": "./dist/components/index.js",
    "./dist/components/*": "./dist/components/*"
  },
  "lint-staged": {
    "*.{css,scss}": "emo run format:css --"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.6",
    "@stencil/core": "4.38.0",
    "@stencil/store": "2.2.2",
    "@tanstack/virtual-core": "^3.13.12",
    "async-validator": "~4.2.5",
    "classnames": "^2.5.1",
    "composed-offset-position": "0.0.6",
    "dayjs": "^1.11.18",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.2",
    "node-fetch": "^2.7.0",
    "sortablejs": "^1.15.7",
    "@byted-keystone/table": "0.0.1",
    "@fe-infra/keystone-design-tokens": "2.0.24",
    "@fe-infra/keystone-icons": "1.0.10",
    "@fe-infra/keystone-icons-stencil": "1.0.10",
    "@fe-infra/keystone-locales": "0.5.3"
  },
  "devDependencies": {
    "@ampproject/remapping": "2.3.0",
    "@axe-core/playwright": "4.10.2",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@stencil-community/postcss": "^2.2.0",
    "@stencil/playwright": "0.2.1",
    "@stencil/sass": "^3.2.2",
    "@tt4b/ttam-props-injector": "2.2.10",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.16.1",
    "@types/postcss-url": "10.0.4",
    "@types/sortablejs": "^1.15.8",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "css-declaration-sorter": "7.4.0",
    "cssnano": "6.1.2",
    "esbuild": "^0.25.10",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-junit": "16.0.0",
    "lodash": "^4.17.21",
    "magic-string": "0.30.19",
    "postcss": "^8.4.47",
    "postcss-scss": "^4.0.9",
    "postcss-url": "^10.1.3",
    "rimraf": "^5.0.1",
    "rollup": "4.52.4",
    "sass": "^1.93.2",
    "stencil-inline-svg": "^1.1.0",
    "typescript": "^5.9.3",
    "@byted-keystone-internal/code-specification": "1.0.0",
    "@byted-keystone/react-output-target": "0.2.10",
    "@byted-keystone/vue-output-target": "0.16.3",
    "@bytedance-dev/rollup-plugin-dealwith-stencil-custom-elements": "1.0.7"
  },
  "scripts": {
    "build": "run-s clean inject build:*",
    "build:stencil": "stencil build",
    "build:commonjs": "node ./scripts/build-commonjs.mjs",
    "build:global-styles": "node ./build/global-styles.js",
    "start": "run-s clean build:global-styles inject start:*",
    "start:stencil": "stencil build --watch",
    "test": "run-p test:scripts test:spec test:e2e",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:spec": "NODE_ENV=test stencil test --spec",
    "test:spec:coverage": "NODE_ENV=test stencil test --spec --coverage",
    "test:e2e": "# NODE_ENV=test playwright test # FIXME E2E environment error to be fixed",
    "test:e2e:debug": "NODE_ENV=test playwright test --ui",
    "test:e2e:update-snapshots": "NODE_ENV=test playwright test --update-snapshots='changed'",
    "generate": "stencil generate",
    "clean": "rimraf dist loader docsreadme www",
    "postinstall": "node postinstall.js",
    "inject": "props-inject -p packages/keystone-ui/core/src/components && emox oxfmt --write src/components",
    "format:css": "node ./scripts/format-css.mjs"
  }
}