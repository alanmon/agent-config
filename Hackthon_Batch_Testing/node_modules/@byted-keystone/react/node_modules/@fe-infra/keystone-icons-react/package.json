{
  "name": "@fe-infra/keystone-icons-react",
  "description": "A Keystone icon library package for react applications.",
  "version": "1.0.10",
  "license": "MIT",
  "bugs": "https://code.byted.org/ad/byted-web-components/issues",
  "repository": {
    "type": "git",
    "url": "https://code.byted.org/ad/byted-web-components",
    "directory": "packages/keystone-icons/targets/react"
  },
  "keywords": [
    "Keystone",
    "Icons",
    "Icon",
    "SVG",
    "React"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@fe-infra/keystone-icons": "1.0.10"
  },
  "devDependencies": {
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "npm run clean && npm run tsc && npm run compile:cjs",
    "start": "tsc -w -p .",
    "tsc": "tsc -p .",
    "compile:cjs": "tsc -p tsconfig.cjs.json",
    "test": "node --import tsx --test __tests__/*.test.tsx",
    "lint:staged": "echo skip lint"
  }
}