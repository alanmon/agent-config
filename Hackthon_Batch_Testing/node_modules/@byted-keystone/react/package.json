    "directory": "keystone/react"
  },
  "keywords": [
    "Keystone",
    "Web Components",
    "Design System",
    "React"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "scripts"
  ],
  "devDependencies": {
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "@types/react-transition-group": "4.4.12",
    "concurrently": "9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@vidstack/react": "1.15.6",
    "@byted-keystone/core": "1.1.68",
    "@byted-keystone/react-output-target": "0.2.10",
    "@fe-infra/keystone-design-tokens": "2.0.24",
