  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run tsc && tsc-alias",
