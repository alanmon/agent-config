{
  "name": "@fe-infra/keystone-icons",
  "description": "A Keystone icon library package for web custom elements applications.",
  "version": "1.0.10",
  "license": "MIT",
  "bugs": "https://code.byted.org/ad/byted-web-components/issues",
  "repository": {
    "type": "git",
    "url": "https://code.byted.org/ad/byted-web-components",
    "directory": "packages/keystone-icons"
  },
  "keywords": [
    "Keystone",
    "Icons",
    "Icon",
    "SVG"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "sideEffects": true,
  "dependencies": {},
  "devDependencies": {
    "@types/lodash-es": "~4.17.12",
    "cheerio": "^1.0.0-rc.12",
    "happy-dom": "^15.11.7",
    "lodash-es": "~4.17.21",
    "rimraf": "^5.0.1",
    "typescript": "^5.2.2",
    "@byted-keystone-internal/code-specification": "1.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:icons && npm run build:ts && npm run build:cjs && npm run build:targets",
    "build:icons": "tsx scripts/build-icons/index.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:targets": "npm --prefix targets/react run compile && npm --prefix targets/vue run compile && npm --prefix targets/stencil run compile",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test __tests__/*.test.ts"
  }
}