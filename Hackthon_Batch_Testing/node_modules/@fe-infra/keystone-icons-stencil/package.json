{
  "name": "@fe-infra/keystone-icons-stencil",
  "description": "A Keystone icon library package for Stencil applications.",
  "version": "1.0.10",
  "license": "MIT",
  "bugs": "https://code.byted.org/ad/byted-web-components/issues",
  "repository": {
    "type": "git",
    "url": "https://code.byted.org/ad/byted-web-components",
    "directory": "packages/keystone-icons/targets/stencil"
  },
  "keywords": [
    "Keystone",
    "Icons",
    "Icon",
    "SVG",
    "Stencil"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@fe-infra/keystone-icons": "1.0.10"
  },
  "devDependencies": {
    "@stencil/core": "^4.38.0",
    "rimraf": "^5.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@stencil/core": "^4.38.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "npm run clean && npm run tsc && npm run compile:cjs",
    "start": "tsc -w -p .",
    "tsc": "tsc -p .",
    "compile:cjs": "tsc -p tsconfig.cjs.json",
    "test": "node --import tsx --test __tests__/*.test.ts",
    "lint:staged": "echo skip lint"
  }
}